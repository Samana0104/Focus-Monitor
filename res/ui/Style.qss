QWidget#mainRoot {
    background-color: #FFFFFF;
    color: #191F28;
    font-family: "Pretendard", "Malgun Gothic", sans-serif;
    font-size: 14px;
}

QFrame#cameraPanel, QFrame#sidePanel {
    background-color: #FFFFFF;
    border: none;
}

QFrame#sidePanel { min-width: 340px; }

QLabel#cameraView, QVideoWidget#cameraVideo, QStackedWidget#cameraStack {
    color: #FFFFFF;
    background-color: #111827;
    border: none;
    border-radius: 16px;
    min-width: 640px;
    min-height: 360px;
}

QLabel#statusLabel { color: #6B7684; font-size: 13px; padding: 4px 2px; }
QListWidget#notificationList {
    background-color: #F2F4F6;
    border: 1px solid #E5E8EB;
    border-radius: 16px;
    outline: none;
    padding: 10px;
}

QListWidget#notificationList::item {
    background-color: transparent;
    border: none;
    padding: 0;
}

QListWidget#notificationList QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px 0;
}

QListWidget#notificationList QScrollBar::handle:vertical {
    background-color: #C9CED6;
    border-radius: 4px;
    min-height: 28px;
}

QListWidget#notificationList QScrollBar::add-line:vertical,
QListWidget#notificationList QScrollBar::sub-line:vertical {
    height: 0;
}

QListWidget#notificationList QScrollBar::add-page:vertical,
QListWidget#notificationList QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QFrame#notificationCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E8EB;
    border-radius: 14px;
}
QLabel#notificationIcon { background-color: #F2F4F6; border: none; border-radius: 10px; padding: 6px; }
QLabel#notificationTitle { color: #191F28; font-size: 15px; font-weight: 700; background-color: transparent; border: none; }
QLabel#notificationTime { color: #8B95A1; font-size: 11px; background-color: transparent; border: none; }
QLabel#notificationDetail { color: #6B7684; font-size: 13px; background-color: transparent; border: none; }

QPushButton {
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 700;
    padding: 0 16px;
}

QPushButton#primaryButton { color: #FFFFFF; background-color: #3182F6; min-height: 52px; }
QPushButton#primaryButton:hover { background-color: #1B64DA; }
QPushButton#primaryButton:pressed { background-color: #1554B8; }
QPushButton#breakButton { color: #3182F6; background-color: #E8F3FF; min-height: 52px; }
QPushButton#breakButton:hover { background-color: #D9ECFF; }
QPushButton#breakButton:pressed { background-color: #C9E2FF; }
QPushButton#primaryButton:disabled, QPushButton#breakButton:disabled {
    color: #8B95A1;
    background-color: #E5E8EB;
}

QPushButton#utilityButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0;
    qproperty-iconSize: 20px 20px;
}
QPushButton#utilityButton:hover { background-color: #F2F4F6; }
QPushButton#utilityButton:pressed { background-color: #E5E8EB; }

QDialog#uiSettingsDialog {
    background-color: #F9FAFB;
    color: #191F28;
    min-width: 480px;
    max-width: 480px;
    min-height: 780px;
    max-height: 780px;
}

QScrollArea#settingsScrollArea,
QScrollArea#settingsScrollArea > QWidget > QWidget,
QWidget#settingsScrollContent {
    background-color: transparent;
    border: none;
}

QScrollArea#settingsScrollArea QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 4px 0;
}

QScrollArea#settingsScrollArea QScrollBar::handle:vertical {
    background-color: #C9CED6;
    border-radius: 4px;
    min-height: 36px;
}

QScrollArea#settingsScrollArea QScrollBar::handle:vertical:hover {
    background-color: #8B95A1;
}

QScrollArea#settingsScrollArea QScrollBar::add-line:vertical,
QScrollArea#settingsScrollArea QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#settingsScrollArea QScrollBar::add-page:vertical,
QScrollArea#settingsScrollArea QScrollBar::sub-page:vertical {
    background-color: transparent;
}

QGroupBox#aiParameterGroup, QGroupBox#audioVolumeGroup, QGroupBox#stateTransitionGroup {
    color: #333D4B;
    background-color: #FFFFFF;
    border: 1px solid #E5E8EB;
    border-radius: 16px;
    margin-top: 14px;
    font-size: 16px;
    font-weight: 700;
}

QGroupBox#aiParameterGroup::title, QGroupBox#audioVolumeGroup::title, QGroupBox#stateTransitionGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    padding: 0 8px;
    background-color: #F9FAFB;
}

QFrame#parameterRow { background-color: transparent; border: none; }
QLabel#parameterTitle { color: #333D4B; font-size: 14px; font-weight: 700; }
QLabel#parameterDescription { color: #8B95A1; font-size: 12px; font-weight: 400; }
QSlider#parameterSlider { min-height: 24px; }
QLabel#parameterValue {
    color: #3182F6;
    background-color: #E8F3FF;
    border-radius: 8px;
    min-width: 42px;
    padding: 4px 8px;
    font-size: 13px;
    font-weight: 700;
}

QSlider#parameterSlider::groove:horizontal {
    height: 4px;
    background-color: #E5E8EB;
    border-radius: 2px;
}

QSlider#parameterSlider::sub-page:horizontal {
    background-color: #3182F6;
    border-radius: 2px;
}

QSlider#parameterSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -7px 0;
    background-color: #FFFFFF;
    border: 2px solid #3182F6;
    border-radius: 9px;
}

QSlider#parameterSlider::handle:horizontal:hover { background-color: #E8F3FF; }

QPushButton#settingsDoneButton {
    color: #FFFFFF;
    background-color: #3182F6;
    border-radius: 12px;
    min-height: 48px;
}
QPushButton#settingsDoneButton:hover { background-color: #1B64DA; }
QPushButton#settingsDoneButton:pressed { background-color: #1554B8; }

QDialog#uiPopupDialog { background-color: transparent; }

QFrame#popupCard {
    color: #191F28;
    background-color: #FFFFFF;
    border: 1px solid #E5E8EB;
    border-radius: 28px;
    font-family: "Pretendard", "Malgun Gothic", sans-serif;
}

QPushButton#popupCloseButton {
    color: #8B95A1;
    background-color: transparent;
    border: none;
    border-radius: 18px;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    padding: 0;
    font-family: "Arial", sans-serif;
    font-size: 27px;
    font-weight: 400;
}
QPushButton#popupCloseButton:hover { color: #333D4B; background-color: #F2F4F6; }
QPushButton#popupCloseButton:pressed { background-color: #E5E8EB; }

QLabel#popupIconBadge {
    color: #3182F6;
    background-color: #E8F3FF;
    border: none;
    border-radius: 31px;
    min-width: 62px;
    max-width: 62px;
    min-height: 62px;
    max-height: 62px;
    font-size: 31px;
    font-weight: 800;
}
QLabel#popupIconBadge[tone="question"] { color: #3182F6; background-color: #E8F3FF; }
QLabel#popupIconBadge[tone="warning"] { color: #D97706; background-color: #FFF4D6; }
QLabel#popupIconBadge[tone="critical"] { color: #E5484D; background-color: #FFF0F0; }
QLabel#popupIconBadge[tone="neutral"] { color: #6B7684; background-color: #F2F4F6; }

QLabel#popupTitle {
    color: #191F28;
    background-color: transparent;
    border: none;
    font-size: 24px;
    font-weight: 800;
}

QLabel#popupReason {
    color: #6B7684;
    background-color: transparent;
    border: none;
    font-size: 15px;
    font-weight: 400;
}

QPushButton#popupPrimaryButton, QPushButton#popupSecondaryButton {
    border: none;
    border-radius: 14px;
    min-height: 56px;
    padding: 0 22px;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#popupPrimaryButton { color: #FFFFFF; background-color: #3182F6; }
QPushButton#popupPrimaryButton:hover { background-color: #1B64DA; }
QPushButton#popupPrimaryButton:pressed { background-color: #1554B8; }
QPushButton#popupSecondaryButton { color: #4E5968; background-color: #F2F4F6; }
QPushButton#popupSecondaryButton:hover { background-color: #E5E8EB; }
QPushButton#popupSecondaryButton:pressed { background-color: #D1D6DB; }
